# Set ONE of these to switch from offline TF-IDF fallback to a real LLM+embeddings.
# Leave both blank to run fully offline (useful for development / demo without wifi).

# Option A: Google Gemini (get a free key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Option B: OpenAI
OPENAI_API_KEY=

# Qdrant: leave blank to run embedded/local (zero setup, saves to ./qdrant_data).
# Set these only if pointing at a real Qdrant server or Qdrant Cloud instance.
QDRANT_URL=
QDRANT_API_KEY=
